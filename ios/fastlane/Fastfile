default_platform(:ios)
require "shellwords"

APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.datachain.visualtimer")
ASC_USERNAME = ENV.fetch("ASC_USERNAME", "michael@datachainconsulting.com")
ASC_TEAM_ID = ENV.fetch("ASC_TEAM_ID", "6564A59YJ2")
ASC_ITC_TEAM_ID = ENV.fetch("ASC_ITC_TEAM_ID", ASC_TEAM_ID)
ASC_KEY_ID = ENV.fetch("ASC_KEY_ID", "YYHR35NSUL")
ASC_ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "8dbcdb9e-29bf-49f7-974c-7a16f3b80bdd")
ASC_KEY_PATH = ENV.fetch("ASC_KEY_PATH", "~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8")
APP_NAME = ENV.fetch("APP_NAME", "VisualTimer: Countdown Clock")
APP_SKU = ENV.fetch("APP_SKU", "DATACHAIN-VISUALTIMER-001")
APP_COPYRIGHT = ENV.fetch("APP_COPYRIGHT", "2026 Michael John T. Peña")

def app_store_connect_key!
  key_path = File.expand_path(ASC_KEY_PATH)
  UI.user_error!("ASC key not found at #{key_path}. Set ASC_KEY_PATH to a valid .p8 file.") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    key_filepath: key_path
  )
end

platform :ios do
  # ──────────────────────────────────────────────
  # Set Privacy (publish data usage declaration)
  # ──────────────────────────────────────────────
  desc "Publish app data usage declaration (no data collected)"
  lane :set_privacy do
    api_key = app_store_connect_key!

    require 'spaceship'
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.message("App: #{app.name} (#{app.id})")

    client = Spaceship::ConnectAPI.client

    begin
      # Use the Tunes API client to publish data usage declaration
      tunes_client = Spaceship::ConnectAPI::Client.instance_variable_get(:@clients)&.dig(:tunes) || 
                     Spaceship::ConnectAPI.client.instance_variable_get(:@tunes_client)
      
      if tunes_client
        body = {
          data: {
            type: "appDataUsagePublications",
            relationships: {
              app: { data: { type: "apps", id: app.id } }
            }
          }
        }
        resp = tunes_client.post("appDataUsagePublications", body)
        UI.success("Published app data usage declaration!")
      else
        # Fallback: use raw HTTP request via the token
        require 'net/http'
        uri = URI("https://api.appstoreconnect.apple.com/v1/appDataUsagePublications")
        http = Net::HTTP.new(uri.host, uri.port)
        http.use_ssl = true
        req = Net::HTTP::Post.new(uri)
        req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
        req["Content-Type"] = "application/json"
        req.body = {
          data: {
            type: "appDataUsagePublications",
            relationships: {
              app: { data: { type: "apps", id: app.id } }
            }
          }
        }.to_json
        resp = http.request(req)
        if resp.code.to_i < 400
          UI.success("Published app data usage declaration!")
        else
          UI.important("HTTP #{resp.code}: #{resp.body[0..200]}")
        end
      end
    rescue => e
      UI.important("Error: #{e.class}: #{e.message[0..300]}")
    end
  end

  # ──────────────────────────────────────────────
  # Build
  # ──────────────────────────────────────────────
  desc "Build for App Store distribution"
  lane :build do
    api_key = app_store_connect_key!
    auth_key_path = Shellwords.escape(File.expand_path(ASC_KEY_PATH))

    build_number = Time.now.strftime("%Y%m%d%H%M")

    set_info_plist_value(
      path: "VisualTimer/Resources/Info.plist",
      key: "CFBundleVersion",
      value: build_number
    )

    build_app(
      project: "VisualTimer.xcodeproj",
      scheme: "VisualTimer",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{auth_key_path} -authenticationKeyID #{ASC_KEY_ID} -authenticationKeyIssuerID #{ASC_ISSUER_ID} DEVELOPMENT_TEAM=#{ASC_TEAM_ID}",
      output_directory: "./build",
      output_name: "VisualTimer.ipa"
    )
  end

  # ──────────────────────────────────────────────
  # TestFlight (Internal)
  # ──────────────────────────────────────────────
  desc "Build and upload to TestFlight for internal testing"
  lane :beta do
    build

    api_key = app_store_connect_key!

    begin
      create_app_online(
        username: ASC_USERNAME,
        app_identifier: APP_IDENTIFIER,
        app_name: APP_NAME,
        language: "English",
        app_version: "1.0.0",
        sku: APP_SKU,
        team_id: ASC_TEAM_ID,
        itc_team_id: ASC_ITC_TEAM_ID
      )
    rescue => e
      UI.important("create_app_online skipped (app may already exist): #{e.message}")
    end

    upload_to_testflight(
      api_key: api_key,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "Latest build with improvements and bug fixes."
    )
  end

  # ──────────────────────────────────────────────
  # Screenshots
  # ──────────────────────────────────────────────
  desc "Upload screenshots to App Store Connect"
  lane :screenshots do
    api_key = app_store_connect_key!

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  # ──────────────────────────────────────────────
  # Upload (no review)
  # ──────────────────────────────────────────────
  desc "Upload binary and metadata to App Store Connect (no review)"
  lane :upload do
    api_key = app_store_connect_key!

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      copyright: APP_COPYRIGHT
    )
  end

  # ──────────────────────────────────────────────
  # TestFlight Upload (uses existing IPA, no rebuild)
  # ──────────────────────────────────────────────
  desc "Upload existing IPA to TestFlight and add internal tester"
  lane :testflight do |options|
    api_key = app_store_connect_key!
    ipa_path = options[:ipa] || File.expand_path("../build/VisualTimer.ipa", __dir__)

    begin
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa_path,
        distribute_external: false,
        notify_external_testers: false,
        changelog: "Latest build with improvements and bug fixes.",
        skip_waiting_for_build_processing: false
      )
    rescue => e
      if e.message.include?("already been used") || e.message.include?("DUPLICATE")
        UI.important("⚠️  Build already uploaded to TestFlight – skipping upload, proceeding to tester assignment.")
      else
        UI.user_error!("TestFlight upload failed: #{e.message}")
      end
    end

    UI.message("Adding internal tester michael@datachainconsulting.com to TestFlight...")
    require 'openssl'
    require 'jwt'
    require 'net/http'
    require 'json'

    tester_email = "michael@datachainconsulting.com"
    key_path     = File.expand_path(ASC_KEY_PATH)

    jwt_token = lambda do
      key = OpenSSL::PKey::EC.new(File.read(key_path))
      payload = { iss: ASC_ISSUER_ID, iat: Time.now.to_i, exp: Time.now.to_i + 1200, aud: "appstoreconnect-v1" }
      JWT.encode(payload, key, "ES256", { kid: ASC_KEY_ID })
    end

    def _asc(method, path, body, jwt_token)
      uri  = URI("https://api.appstoreconnect.apple.com#{path}")
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = true
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post }[method]
      req  = klass.new(uri)
      req["Authorization"] = "Bearer #{jwt_token.call}"
      req["Content-Type"]  = "application/json"
      req.body = body.to_json if body
      resp = http.request(req)
      [resp.code.to_i, (JSON.parse(resp.body) rescue resp.body)]
    end

    # Resolve app ID
    _, apps = _asc(:get, "/v1/apps?filter[bundleId]=#{APP_IDENTIFIER}&fields[apps]=bundleId", nil, jwt_token)
    app_id = apps.dig("data", 0, "id")
    UI.user_error!("Could not resolve app ID") unless app_id

    # Get or create internal beta group
    _, groups = _asc(:get, "/v1/apps/#{app_id}/betaGroups?filter[isInternalGroup]=true&fields[betaGroups]=name,isInternalGroup", nil, jwt_token)
    group_id = groups.dig("data", 0, "id")
    unless group_id
      _, created_group = _asc(:post, '/v1/betaGroups', {
        data: {
          type: 'betaGroups',
          attributes: { name: 'App Store Connect Users', isInternalGroup: true, publicLinkEnabled: false },
          relationships: { app: { data: { type: 'apps', id: app_id } } }
        }
      }, jwt_token)
      group_id = created_group.dig('data', 'id')
      UI.message("Created internal beta group #{group_id}")
    end
    UI.user_error!("Could not find or create internal beta group") unless group_id

    # Add the latest valid build to the internal group
    _, builds = _asc(:get, "/v1/builds?filter[app]=#{app_id}&filter[processingState]=VALID&sort=-uploadedDate&limit=1&fields[builds]=version", nil, jwt_token)
    build_id = builds.dig('data', 0, 'id')
    if build_id
      build_code, _ = _asc(:post, "/v1/betaGroups/#{group_id}/relationships/builds", { data: [{ type: 'builds', id: build_id }] }, jwt_token)
      UI.success("✅ Build added to internal TestFlight group") if build_code < 300
    end

    # Find existing beta tester by email
    _, existing = _asc(:get, "/v1/betaTesters?filter[email]=#{tester_email}&filter[apps]=#{app_id}&fields[betaTesters]=email", nil, jwt_token)
    tester_id = existing.dig("data", 0, "id")

    if tester_id.nil?
      # Create the external beta tester (team members are already internal)
      code, created = _asc(:post, "/v1/betaTesters", {
        data: {
          type: "betaTesters",
          attributes: { email: tester_email },
          relationships: {
            betaGroups: { data: [{ type: "betaGroups", id: group_id }] }
          }
        }
      }, jwt_token)
      if code < 300
        UI.success("✅ Added #{tester_email} to internal TestFlight group")
      else
        UI.important("ℹ️  #{tester_email} (#{code}): App Store Connect Users are added automatically as team members.")
      end
    else
      # Try adding to group; 409 = already a team member (expected for internal groups)
      code, _ = _asc(:post, "/v1/betaGroups/#{group_id}/relationships/betaTesters", {
        data: [{ type: "betaTesters", id: tester_id }]
      }, jwt_token)
      if code < 300
        UI.success("✅ Added #{tester_email} to internal TestFlight group")
      elsif code == 409
        UI.success("✅ #{tester_email} is a team member – automatically an internal TestFlight tester")
      else
        UI.important("⚠️  Could not add tester to group (#{code})")
      end
    end
  end

  # ──────────────────────────────────────────────
  # Submit for Review
  # ──────────────────────────────────────────────
  desc "Submit current build for App Store review"
  lane :submit do
    api_key = app_store_connect_key!
    app_version = get_version_number(xcodeproj: "VisualTimer.xcodeproj", target: "VisualTimer")

    begin
      submission_script = File.expand_path("submit_for_review.rb", __dir__)
      sh(
        {
          "ASC_KEY_ID" => ASC_KEY_ID,
          "ASC_ISSUER_ID" => ASC_ISSUER_ID,
          "ASC_KEY_PATH" => File.expand_path(ASC_KEY_PATH),
          "APP_BUNDLE_ID" => APP_IDENTIFIER,
          "APP_VERSION_STRING" => app_version
        },
        "ruby #{Shellwords.escape(submission_script)}"
      )
      UI.success("✅ Submitted for App Store review!")
    rescue => e
      UI.user_error!("App Store submission failed: #{e.message}")
    end
  end

  # ──────────────────────────────────────────────
  # Release (full pipeline)
  # ──────────────────────────────────────────────
  desc "Full release: build → TestFlight → metadata → submit"
  lane :release do
    build

    api_key = app_store_connect_key!
    app_version = get_version_number(xcodeproj: "VisualTimer.xcodeproj", target: "VisualTimer")

    upload_to_testflight(
      api_key: api_key,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "New build - see App Store release notes for details."
    )

    begin
      upload_to_app_store(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        skip_binary_upload: true,
        skip_metadata: false,
        skip_screenshots: true,
        submit_for_review: false,
        automatic_release: false,
        run_precheck_before_submit: false,
        force: true,
        copyright: APP_COPYRIGHT
      )
    rescue => e
      UI.important("⚠️  Metadata upload skipped: #{e.message.split('.').first}")
    end

    begin
      submission_script = File.expand_path("submit_for_review.rb", __dir__)
      sh(
        {
          "ASC_KEY_ID" => ASC_KEY_ID,
          "ASC_ISSUER_ID" => ASC_ISSUER_ID,
          "ASC_KEY_PATH" => File.expand_path(ASC_KEY_PATH),
          "APP_BUNDLE_ID" => APP_IDENTIFIER,
          "APP_VERSION_STRING" => app_version
        },
        "ruby #{Shellwords.escape(submission_script)}"
      )
      UI.success("✅ Submitted for App Store review!")
    rescue => e
      UI.user_error!("App Store submission failed: #{e.message}")
    end
  end
end
